{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "diagnostics": {
    "globals": ["vim"],
    "disable": [
      "undefined-field",
      "undefined-doc-name",
      "inject-field"
    ]
  },
  "workspace": {
    "checkThirdParty": false
  },
  "format": {
    "enable": true,
    "defaultConfig": {
      "indent_style": "space",
      "indent_size": "2",
      "quote_style": "none"
    }
  }
}
